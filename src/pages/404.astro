---
// One 404 for the whole site (static hosts serve /404.html), in both languages.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ui, type Lang } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';

const blocks: { lang: Lang; dir: 'ltr' | 'rtl' }[] = [
  { lang: 'en', dir: 'ltr' },
  { lang: 'he', dir: 'rtl' },
];
---

<BaseLayout title={ui.en['notFound.title']} description={ui.en['notFound.body']}>
  <section class="mx-auto grid max-w-[880px] gap-6 px-4 pt-12 pb-16 sm:px-6 md:grid-cols-2">
    {
      blocks.map(({ lang, dir }, i) => (
        <div lang={lang} dir={dir} class="flex flex-col gap-4 rounded-card border border-line bg-card p-6 sm:p-7">
          {i === 0 ? (
            <h1 class="m-0 text-[32px] leading-tight">{ui[lang]['notFound.title']}</h1>
          ) : (
            <h2 class="m-0 text-[32px] leading-tight">{ui[lang]['notFound.title']}</h2>
          )}
          <p class="m-0 text-lg leading-relaxed text-[#3E4A5E]">{ui[lang]['notFound.body']}</p>
          <div class="flex flex-wrap gap-3">
            <a
              href={localizePath('/#courses', lang)}
              class="inline-flex min-h-12 items-center rounded-control bg-navy px-5 font-semibold text-white no-underline hover:text-white"
            >
              {ui[lang]['notFound.courses']}
            </a>
            <a
              href={localizePath('/fund-checker', lang)}
              class="inline-flex min-h-12 items-center rounded-control border border-line-strong bg-card px-5 font-semibold text-navy no-underline hover:border-navy hover:text-navy"
            >
              {ui[lang]['notFound.checker']}
            </a>
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
