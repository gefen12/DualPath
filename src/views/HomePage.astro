---
import { getCollection } from 'astro:content';
import productsJson from '../../content/products.json';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Quiz, { type QuizLabels, type QuizLesson } from '@/components/home/Quiz';
import { type Lang } from '@/i18n/ui';
import { fill, localizePath, useTranslations } from '@/i18n/utils';
import { getAllLessons, getCourse, lessonPath, lessonTitles, modulePath, moduleTitles } from '@/lib/course';
import { quiz, site } from '@/lib/data';
import { upcoming } from '@/lib/deadlines';
import { verdictStyles } from '@/lib/verdicts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const he = lang === 'he';
const other: Lang = he ? 'en' : 'he';
const otherDir = other === 'he' ? 'rtl' : 'ltr';

// Calendar card: the next few deadlines. Ordered at build time, and again in the
// browser (script below) so "next" is always relative to the visitor's today.
const CALENDAR_SIZE = 4;
const deadlines = upcoming((await getCollection('deadlines')).map((d) => d.data));
const dayLabel = new Intl.DateTimeFormat(he ? 'he-IL' : 'en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

// Quiz: questions in the page language, plus the lessons it can recommend.
const localQuiz = {
  ...quiz,
  questions: quiz.questions.map((q) => ({
    ...q,
    label: he ? q.labelHe : q.label,
    answers: q.answers.map((a) => ({ ...a, label: he ? a.labelHe : a.label })),
  })),
};
const allLessons = await getAllLessons();
const quizLessons: Record<string, QuizLesson> = Object.fromEntries(
  quiz.path.flatMap(({ lesson: ref }) => {
    const lesson = allLessons.find((l) => l.ref === ref);
    return lesson
      ? [[ref, { title: lessonTitles(lesson, lang).title, minutes: lesson.en.data.minutes ?? 0, href: localizePath(lessonPath(lesson), lang) }]]
      : [];
  }),
);
const quizLabels: QuizLabels = {
  pathTitle: t('quiz.pathTitle'),
  progress: t('quiz.progress'),
  summary: t('quiz.summary'),
  minutes: t('learn.minutes'),
  empty: t('quiz.empty'),
  start: t('quiz.start'),
  reset: t('quiz.reset'),
};

const modules = await getCourse();

// Allowed vs Avoid comes straight from products.json, in file order.
const products = productsJson.map((p) => ({ id: p.id, name: he ? p.nameHe : p.name, verdict: p.verdict as keyof typeof verdictStyles }));
const ofVerdict = (v: keyof typeof verdictStyles) => products.filter((p) => p.verdict === v);
const columns = (['ok', 'avoid'] as const).map((v) => ({ verdict: v, style: verdictStyles[v], items: ofVerdict(v) }));
const listFormat = new Intl.ListFormat(he ? 'he' : 'en', { style: 'long', type: 'conjunction' });
const dependsNames = listFormat.format(ofVerdict('depends').map((p) => p.name));
---

<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto grid max-w-[1180px] items-center gap-12 px-4 pt-12 pb-14 sm:px-6 lg:grid-cols-2 lg:pt-18">
    <div class="flex flex-col gap-5">
      <span class="self-start rounded-full bg-blue-tint px-3 py-1.5 text-[13px] font-semibold tracking-wide text-blue uppercase">
        {t('home.eyebrow')}
      </span>
      <h1 class="m-0 text-[38px] leading-[1.04] tracking-tight sm:text-[54px]">{t('home.title')}</h1>
      <p class="m-0 max-w-[560px] text-lg leading-relaxed text-[#3E4A5E] sm:text-[19px]">{t('home.intro')}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href="#quiz"
          class="inline-flex min-h-12 items-center rounded-control bg-navy px-5.5 font-semibold text-white no-underline hover:text-white"
        >
          {t('home.ctaStart')}
        </a>
        <a
          href="#courses"
          class="inline-flex min-h-12 items-center rounded-control border border-line-strong bg-card px-5.5 font-semibold text-navy no-underline hover:border-navy hover:text-navy"
        >
          {t('home.ctaBrowse')}
        </a>
      </div>
      <p class="m-0 text-sm text-muted">
        {fill(t('home.reviewed'), { name: site.reviewer, title: he ? site.reviewerTitleHe : site.reviewerTitle, date: site.lastReviewed })}
      </p>
    </div>

    <section aria-labelledby="calendar-title" class="flex flex-col gap-4 rounded-card border border-line bg-card p-6 shadow-hero sm:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h2 id="calendar-title" class="m-0 text-[22px]">{t('home.calendarTitle')}</h2>
        <span class="text-[13px] text-muted">{fill(t('home.calendarNext'), { n: Math.min(CALENDAR_SIZE, deadlines.length) })}</span>
      </div>
      <ol class="m-0 flex list-none flex-col p-0" data-upcoming={CALENDAR_SIZE}>
        {
          deadlines.map(({ deadline: d }, i) => (
            <li
              data-month={d.month}
              data-day={d.day}
              hidden={i >= CALENDAR_SIZE}
              class="grid grid-cols-[74px_minmax(0,1fr)] items-center gap-3.5 border-t border-[#EEF1F5] py-3 first:border-t-0"
            >
              <span class="rounded-[10px] bg-blue-tint py-2 text-center text-sm font-semibold text-blue">
                {dayLabel.format(new Date(Date.UTC(2001, d.month - 1, d.day)))}
              </span>
              <span class="flex min-w-0 flex-col">
                <span class="font-semibold">{he ? d.titleHe : d.title}</span>
                <span class="text-sm text-muted">{he ? d.noteHe : d.note}</span>
              </span>
            </li>
          ))
        }
      </ol>
      <a href={localizePath('/deadlines', lang)} class="inline-flex min-h-11 items-center gap-1.5 self-start text-[15px] font-semibold">
        {t('home.calendarLink')}
        <svg class="rtl:-scale-x-100" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </a>
    </section>
  </section>

  <!-- Quiz -->
  <section id="quiz" aria-labelledby="quiz-title" class="scroll-mt-4 bg-navy text-white">
    <div class="mx-auto flex max-w-[1180px] flex-col gap-8 px-4 py-14 sm:px-6 sm:py-16">
      <div>
        <p class="m-0 text-[13px] font-semibold tracking-wider text-[#9CC0F5] uppercase">{t('quiz.eyebrow')}</p>
        <h2 id="quiz-title" class="m-0 mt-2 text-[32px] leading-tight sm:text-[38px]">{t('quiz.title')}</h2>
        <p class="m-0 mt-2.5 text-[17px] leading-normal text-[#C7D0DE]">{t('quiz.intro')}</p>
      </div>
      <Quiz client:load quiz={localQuiz} labels={quizLabels} lessons={quizLessons} />
    </div>
  </section>

  <!-- Course grid -->
  <section id="courses" aria-labelledby="courses-title" class="mx-auto flex max-w-[1180px] scroll-mt-4 flex-col gap-7 px-4 pt-16 pb-6 sm:px-6 sm:pt-18">
    <div>
      <h2 id="courses-title" class="m-0 text-[32px] sm:text-[38px]">{t('course.title')}</h2>
      <p class="m-0 mt-2 text-[17px] text-[#3E4A5E]">{t('course.intro')}</p>
    </div>
    <ol class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        modules.map((m) => {
          const names = moduleTitles(m, lang);
          const count = m.lessons.length;
          const countLabel =
            count === 0 ? t('learn.comingSoon') : count === 1 ? t('learn.lessonsCountOne') : fill(t('learn.lessonsCount'), { n: count });
          return (
            <li>
              <a
                href={localizePath(modulePath(m.id), lang)}
                class="flex h-full min-h-[170px] flex-col gap-2.5 rounded-card border border-line bg-card p-5.5 text-navy no-underline hover:border-blue hover:text-navy"
              >
                <span class="flex items-center justify-between gap-3">
                  <span class="font-display text-[28px] font-extrabold text-blue">{String(m.data.num).padStart(2, '0')}</span>
                  <span class="text-[13px] text-muted">
                    {countLabel}
                  </span>
                </span>
                <span class="text-lg leading-snug font-semibold">{names.title}</span>
                <span class="text-page-start text-sm text-muted" lang={other} dir={otherDir}>{names.subtitle}</span>
                <span class="text-sm leading-normal text-[#3E4A5E]">{names.description}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <!-- Allowed vs Avoid -->
  <section aria-labelledby="allowed-title" class="mx-auto flex max-w-[1180px] flex-col gap-6 px-4 pt-14 pb-16 sm:px-6">
    <div>
      <h2 id="allowed-title" class="m-0 text-[32px] sm:text-[38px]">{t('allowed.title')}</h2>
      <p class="m-0 mt-2 text-[17px] text-[#3E4A5E]">{t('allowed.intro')}</p>
    </div>

    <!-- A plain GET form: works without JavaScript and opens the checker with the search filled in. -->
    <form action={localizePath('/fund-checker', lang)} method="get" role="search" class="flex max-w-[560px] gap-2">
      <label for="home-product-search" class="sr-only">{t('allowed.searchLabel')}</label>
      <div class="flex min-h-13 min-w-0 flex-1 items-center gap-2.5 rounded-control border border-line-strong bg-card px-4 focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-blue">
        <svg class="shrink-0 text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input
          id="home-product-search"
          name="q"
          type="search"
          placeholder={t('allowed.searchPlaceholder')}
          autocomplete="off"
          class="min-w-0 flex-1 border-0 bg-transparent py-3 text-base text-navy outline-none placeholder:text-muted"
        />
      </div>
      <button type="submit" class="min-h-13 shrink-0 cursor-pointer rounded-control border-0 bg-navy px-5 font-semibold text-white">
        {t('allowed.searchButton')}
      </button>
    </form>

    <div class="grid gap-4 md:grid-cols-2">
      {
        columns.map((c) => (
          <section aria-labelledby={`allowed-${c.verdict}`} class="flex flex-col gap-3.5 rounded-card border border-line bg-card p-6">
            <div class="flex items-center gap-2.5">
              <span class={`flex size-8 shrink-0 items-center justify-center rounded-full ${c.style.classes}`} aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={c.style.icon} />
                </svg>
              </span>
              <h3 id={`allowed-${c.verdict}`} class={`m-0 font-sans text-xl font-semibold ${c.verdict === 'ok' ? 'text-ok' : 'text-avoid'}`}>
                {t(c.style.label)}
              </h3>
            </div>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-base">
              {c.items.map((p) => (
                <li>
                  <a href={`${localizePath('/fund-checker', lang)}?q=${encodeURIComponent(p.name)}`} class="text-navy no-underline hover:text-blue hover:underline">
                    {p.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="m-0 flex items-start gap-3 rounded-[14px] bg-depends-bg px-5 py-4 text-[15px] leading-normal text-[#6B3307]">
      <svg class="mt-0.5 shrink-0 text-depends" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={verdictStyles.depends.icon}></path></svg>
      <span><b>{t('allowed.depends')}</b> {dependsNames}. {t('allowed.dependsNote')}</span>
    </p>

    <a href={localizePath('/fund-checker', lang)} class="inline-flex min-h-11 items-center gap-1.5 self-start font-semibold">
      {t('allowed.openChecker')}
      <svg class="rtl:-scale-x-100" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
    </a>
  </section>
</BaseLayout>

<script>
  import { nextOccurrence } from '@/lib/deadlines';

  // Re-order the calendar card by the visitor's today and show the first few.
  document.querySelectorAll<HTMLOListElement>('[data-upcoming]').forEach((list) => {
    const size = Number(list.dataset.upcoming);
    const items = [...list.querySelectorAll<HTMLLIElement>('li[data-month]')];
    const next = (li: HTMLLIElement) => nextOccurrence({ month: Number(li.dataset.month), day: Number(li.dataset.day) }).getTime();
    items.sort((a, b) => next(a) - next(b));
    items.forEach((li, i) => {
      li.hidden = i >= size;
      list.append(li);
    });
  });
</script>
