---
// Temporary page for the Step 1 review. Replaced by the real homepage in Step 5.
import { type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const he = lang === 'he';

const swatches = [
  { name: 'navy', hex: '#13233F', cls: 'bg-navy' },
  { name: 'blue', hex: '#1F5FBF', cls: 'bg-blue' },
  { name: 'blue-tint', hex: '#E8F0FC', cls: 'bg-blue-tint' },
  { name: 'page', hex: '#F7F8FA', cls: 'bg-page' },
  { name: 'card', hex: '#FFFFFF', cls: 'bg-card' },
  { name: 'muted', hex: '#5A6578', cls: 'bg-muted' },
];

const verdicts = [
  { key: 'ok', en: 'Usually fine', he: 'בדרך כלל בסדר', cls: 'bg-ok-bg text-ok', icon: 'M20 6 9 17l-5-5' },
  { key: 'avoid', en: 'Usually avoid', he: 'בדרך כלל להימנע', cls: 'bg-avoid-bg text-avoid', icon: 'M18 6 6 18M6 6l12 12' },
  { key: 'depends', en: 'It depends', he: 'תלוי', cls: 'bg-depends-bg text-depends', icon: 'M12 8v5M12 16.5v.01M12 3 2 20h20Z' },
];
---

<section class="mx-auto flex max-w-[1180px] flex-col gap-10 px-4 py-12 sm:px-6 sm:py-16">
  <div class="flex flex-col gap-4">
    <span class="self-start rounded-full bg-blue-tint px-3 py-1.5 text-[13px] font-semibold tracking-wide text-blue uppercase">
      {he ? 'שלב 1 · תצוגה מקדימה' : 'Step 1 · Setup preview'}
    </span>
    <h1 class="m-0 text-4xl leading-[1.05] sm:text-[54px]">
      {he ? 'אמריקאים שגרים בישראל: מה לעשות עם הכסף.' : 'For Americans living in Israel: what to do with your money.'}
    </h1>
    <p class="m-0 max-w-[560px] text-lg leading-relaxed text-[#3E4A5E]">
      {
        he
          ? 'עמוד זמני לבדיקת ההגדרות: צבעים, גופנים, כותרת עליונה, כותרת תחתונה ומעבר שפה. דף הבית האמיתי נבנה בשלב 5.'
          : 'Temporary page to review the setup: colors, fonts, header, footer and language switching. The real homepage comes in Step 5.'
      }
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div class="flex flex-col gap-4 rounded-card border border-line bg-card p-6 shadow-hero">
      <h2 class="m-0 text-2xl">{he ? 'צבעים' : 'Colors'}</h2>
      <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3">
        {
          swatches.map((s) => (
            <li class="flex flex-col gap-1.5">
              <span class={`block h-12 rounded-control border border-line ${s.cls}`} />
              <span class="text-sm font-semibold" dir="ltr">{s.name}</span>
              <span class="text-xs text-muted" dir="ltr">{s.hex}</span>
            </li>
          ))
        }
      </ul>
      <h3 class="m-0 mt-2 text-lg">{he ? 'תגיות פסיקה' : 'Verdict badges'}</h3>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {
          verdicts.map((v) => (
            <li class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold ${v.cls}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={v.icon} />
              </svg>
              {he ? v.he : v.en}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4 rounded-card border border-line bg-card p-6">
      <h2 class="m-0 text-2xl">{he ? 'גופנים' : 'Type'}</h2>
      <p class="m-0 font-display text-3xl font-extrabold" lang="en" dir="ltr">Bricolage Grotesque 800</p>
      <p class="m-0 font-sans text-base" lang="en" dir="ltr">IBM Plex Sans — body text for lessons and tools.</p>
      <p class="m-0 font-hebrew text-base font-medium" lang="he" dir="rtl">Heebo — טקסט בעברית, למשל קרן השתלמות או ביטוח לאומי.</p>
      <div class="flex flex-col gap-0.5 border-t border-line pt-4">
        <span class="font-semibold" lang="en" dir="ltr">Mutual fund</span>
        <span class="font-hebrew text-sm text-muted" lang="he" dir="rtl">קרן נאמנות</span>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="#main" class="inline-flex min-h-12 items-center rounded-control bg-navy px-5 font-semibold text-white no-underline hover:text-white">
          {he ? 'כפתור ראשי' : 'Primary button'}
        </a>
        <a href="#main" class="inline-flex min-h-12 items-center rounded-control border border-line-strong bg-card px-5 font-semibold text-navy no-underline hover:text-navy">
          {he ? 'כפתור משני' : 'Secondary button'}
        </a>
      </div>
    </div>
  </div>
</section>
