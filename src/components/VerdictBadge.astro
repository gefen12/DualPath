---
import type { Product } from '@/lib/schemas';
import { verdictStyles } from '@/lib/verdicts';
import { type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  verdict: Product['verdict'];
  lang: Lang;
}

const { verdict, lang } = Astro.props;
const t = useTranslations(lang);
const style = verdictStyles[verdict];
---

<span class={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-sm font-semibold ${style.classes}`}>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={style.icon}></path>
  </svg>
  {t(style.label)}
</span>
