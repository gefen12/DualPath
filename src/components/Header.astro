---
import LanguageSwitch from './LanguageSwitch.astro';
import { type Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '/#courses', label: t('nav.courses') },
  { href: '/fund-checker', label: t('nav.fundChecker') },
  { href: '/deadlines', label: t('nav.deadlines') },
  { href: '/glossary', label: t('nav.glossary') },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<header class="border-b border-line bg-card">
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6 sm:py-4"
  >
    <a
      href={localizePath('/', lang)}
      class="flex min-h-11 min-w-0 flex-1 items-center gap-2.5 text-navy no-underline hover:text-navy md:flex-none"
    >
      <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-navy" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#FFFFFF"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 12h6"></path><path d="M14 12h6"></path><circle cx="12" cy="12" r="2.5"></circle>
          <path d="M4 6h16"></path><path d="M4 18h16"></path>
        </svg>
      </span>
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="font-display text-xl font-extrabold" lang="en">{t('site.name')}</span>
        <span
          class="text-xs text-muted"
          lang={t('site.taglineLang')}
          dir={t('site.taglineLang') === 'he' ? 'rtl' : 'ltr'}
        >
          {t('site.tagline')}
        </span>
      </span>
    </a>

    <!-- Mobile: logo and language switch on the first row, links below. -->
    <div class="order-2 md:order-3">
      <LanguageSwitch lang={lang} />
    </div>
    <nav aria-label={t('nav.label')} class="order-3 w-full md:order-2 md:ms-auto md:w-auto">
      <ul class="m-0 flex list-none flex-wrap items-center gap-x-4 gap-y-0 p-0 text-sm font-medium sm:gap-x-5 sm:text-[15px]">
        {
          links.map((link) => {
            const href = localizePath(link.href, lang);
            const isCurrent = !link.href.includes('#') && current === href.replace(/\/$/, '');
            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-11 items-center text-navy no-underline hover:text-blue hover:underline',
                    isCurrent && 'text-blue underline underline-offset-4',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
